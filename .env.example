# Include /v1 if required by your provider. Never use NEXT_PUBLIC_ for secrets.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
DATABASE_URL="file:./dev.db"
# Set your own password (at least 12 characters). No default teacher password.
TEACHER_PASSWORD=
# Missing AI_API_KEY always selects explicitly labelled demo replies.
DEMO_MODE=false
